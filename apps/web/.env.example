# Environment template — copy to .env.local and fill in. NEVER commit real values.
# Public (browser-safe by design — PostHog project token is publishable, NOT a secret):
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com
# Canonical site URL used for sitemap, robots, canonicals, and JSON-LD:
NEXT_PUBLIC_SITE_URL=https://awakenagain.com
# Meta (Facebook) pixel ID (public by design — it appears in page source
# wherever the pixel runs; NOT a secret). Ported 2026-11-02 from the
# Oct 28 staged build, DARK BY DEFAULT: when unset/empty the pixel
# renders nothing, loads nothing, and makes no network calls. When set,
# it fires ONLY after the visitor accepts analytics consent (shared
# consent bar with PostHog). The value is the numeric ID of the
# "AwakenAgain Website" dataset/pixel Amber creates in Meta Events
# Manager — until she creates it and sends the ID, leave this unset.
# Events: PageView, ViewContent (product pages), Lead (quiz lead
# capture) — never Purchase (checkout completes off-site through the
# Bluevine invoice flow, so an on-site Purchase would be false data).
# NEXT_PUBLIC_META_PIXEL_ID=
# Stripe publishable key (public by design — safe in the browser):
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-only (never NEXT_PUBLIC_, never in client bundles):
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# Transactional email (Resend) — when RESEND_API_KEY is set, order
# confirmation emails are REALLY sent; when absent, the app falls back
# to a logging provider (no sends, no crash). The sending domain
# (awakenagain.com) must be verified in the Resend account, and
# ORDERS_FROM_EMAIL must be an address on that verified domain.
# RESEND_API_KEY=
# ORDERS_FROM_EMAIL="Amber's Alchemy Apothecary <orders@awakenagain.com>"
# Embedded card checkout (Stripe) — card is the card path;
# Venmo/Cash App unchanged. STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET
# are server-only; only the publishable key (top of this file) is
# public. When the secret/publishable keys are absent, the card option
# degrades gracefully (Venmo/Cash App keep working). Register the
# webhook endpoint in Stripe as
# https://awakenagain.com/api/stripe/webhook for
# checkout.session.completed + payment_intent.succeeded, then paste
# its signing secret here.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PAYMENTS_LEDGER_PATH=  (optional; local-dev override only)
# ZAPIER_CONTACT_WEBHOOK=
# ZAPIER_CONSULTATION_WEBHOOK=
# ZAPIER_SOAP_ORDER_WEBHOOK=
# ZAPIER_ORDER_WEBHOOK=

# Authorize.net card checkout (card build 2026-11-09) — 'Pay by card'
# as a third option at /checkout, SHOP ORDERS ONLY. Secrets live ONLY
# in the host's environment settings, never in the repo; this file
# carries names + comments only. TEST MODE FIRST: AUTHORIZENET_ENV
# stays 'sandbox' until the owner approves production credentials.
# CARD_PAYMENTS_ENABLED is the feature flag: exactly 'true' (with the
# API Login ID + Transaction Key present) makes the card option
# appear; unset / any other value (the default) keeps /checkout
# exactly as it is today (Bluevine invoice + Cash App/Venmo).
# The webhook additionally requires AUTHORIZENET_SIGNATURE_KEY.
# Register the webhook endpoint in Authorize.net as
# https://awakenagain.com/api/webhooks/authorizenet for the payment
# authcapture / fraud / refund / void events, then set its
# Signature Key here.
# CARD_PAYMENTS_ENABLED=
# AUTHORIZENET_API_LOGIN_ID=
# AUTHORIZENET_TRANSACTION_KEY=
# AUTHORIZENET_SIGNATURE_KEY=
# AUTHORIZENET_ENV=sandbox
# AUTHORIZENET_WEBHOOK_URL=
