# Environment template — copy to .env.local and fill in. NEVER commit real values.
# Public (browser-safe by design — PostHog project token is publishable, NOT a secret):
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com
# Canonical site URL used for sitemap, robots, canonicals, and JSON-LD:
NEXT_PUBLIC_SITE_URL=https://awakenagain.com
# Stripe publishable key (public by design — safe in the browser):
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-only (never NEXT_PUBLIC_, never in client bundles):
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# Transactional email (Resend) — when RESEND_API_KEY is set, order
# confirmation emails are REALLY sent; when absent, the app falls back
# to a logging provider (no sends, no crash). The sending domain
# (awakenagain.com) must be verified in the Resend account, and
# ORDERS_FROM_EMAIL must be an address on that verified domain.
# RESEND_API_KEY=
# ORDERS_FROM_EMAIL="Amber's Alchemy Apothecary <orders@awakenagain.com>"
# Embedded card checkout (Stripe) — card is the primary card path;
# the Bookipi invoice stays as the in-app backup; Venmo/Cash App
# unchanged. STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET are server-only;
# only the publishable key (top of this file) is public. When the
# secret/publishable keys are absent, the card option degrades
# gracefully (invoice/Venmo/Cash App keep working). Register the
# webhook endpoint in Stripe as
# https://awakenagain.com/api/stripe/webhook for
# checkout.session.completed + payment_intent.succeeded, then paste
# its signing secret here.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PAYMENTS_LEDGER_PATH=  (optional; local-dev override only)
# ZAPIER_CONTACT_WEBHOOK=
# ZAPIER_CONSULTATION_WEBHOOK=
# ZAPIER_SOAP_ORDER_WEBHOOK=
# ZAPIER_ORDER_WEBHOOK=
