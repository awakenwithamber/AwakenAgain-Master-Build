# Environment template — copy to .env.local and fill in. NEVER commit real values.
# Public (browser-safe by design — PostHog project token is publishable, NOT a secret):
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com
# Canonical site URL used for sitemap, robots, canonicals, and JSON-LD:
NEXT_PUBLIC_SITE_URL=https://awakenagain.com

# Server-only (never NEXT_PUBLIC_, never in client bundles):
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# ZAPIER_CONTACT_WEBHOOK=
# ZAPIER_CONSULTATION_WEBHOOK=
# ZAPIER_SOAP_ORDER_WEBHOOK=
# ZAPIER_ORDER_WEBHOOK=
